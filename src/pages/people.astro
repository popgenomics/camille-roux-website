---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout
  title="People — Camille Roux"
  description="Students, postdocs, and collaborators in the research group of Camille Roux at ISEM."
>
  <div class="mx-auto flex max-w-6xl flex-col">
    <SiteHeader current="people" />

    <section class="py-12 lg:py-16">
      <h1 class="section-title">People</h1>
      <p class="section-intro mt-4 max-w-2xl">
        This page will list students, postdocs, collaborators, and former trainees involved
        in my research projects.
      </p>
      <p class="mt-8 max-w-xl text-sm leading-6 text-[var(--muted)]">
        Group members and alumni will be listed here as the page is developed.
      </p>
    </section>
  </div>
</BaseLayout>
